# Copy to `.env` in the project root (same folder as package.json).
# Never commit `.env` — it is gitignored.

# Google Maps SDK key (Maps SDK for Android + iOS if using Google provider)
GOOGLE_MAPS_API_KEY=

# OSRM-compatible routing base (HTTPS only, no trailing slash).
# Limited development testing only — e.g.:
#   ROUTING_BASE_URL=https://router.project-osrm.org
# Public demo is NOT production hosting (≤1 req/s, User-Agent, no uptime guarantee).
# Leave empty to disable road-route preview. App never silently switches providers.
ROUTING_BASE_URL=
