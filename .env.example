# Copy patterns:
#   .env.development  → Android/iOS debug builds
#   .env.production   → release builds (must be HTTPS)
# Never commit real secrets. Do not put passwords or JWT keys here.

# Rider WebAPI base URL (no trailing slash)
# Debug / LAN example:
API_BASE_URL=http://192.168.25.18:8086

# Release example (required HTTPS):
# API_BASE_URL=https://rider-api.yourdomain.com

# Google Maps SDK key (Maps SDK for Android + iOS if using Google provider)
GOOGLE_MAPS_API_KEY=
