# Local / deployment secrets for Rider.WebAPI
# Copy to environment variables or gitignored appsettings.Local.json.
# Do NOT put real production values in source control.
#
# REQUIRED:
#   Jwt__Key
#   EncryptionKey__key
#   PosIntegration__ApiKey
#   ConnectionStrings__DefaultConnection
#
# OPTIONAL:
#   EmailSettings__MailServer / User / Password
#   Firebase__ServiceAccountPath
#
# Example (PowerShell):
#   $env:Jwt__Key = "<base64-or-long-random>"
#   $env:EncryptionKey__key = "<base64-32-byte-key>"
#   $env:PosIntegration__ApiKey = "<pos-key>"
#   $env:ConnectionStrings__DefaultConnection = "Server=...;Database=RiderManagement;..."
#
# Or create appsettings.Local.json next to appsettings.json (gitignored):
# {
#   "ConnectionStrings": { "DefaultConnection": "..." },
#   "Jwt": { "Key": "..." },
#   "EncryptionKey": { "key": "..." },
#   "PosIntegration": { "ApiKey": "..." }
# }
