{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest"]
  },
  "include": [
    "App.tsx",
    "index.js",
    "src/**/*.ts",
    "src/**/*.tsx",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx"
  ],
  "exclude": [
    "**/node_modules",
    "**/Pods",
    "AdminPortal",
    "Backend",
    "android",
    "ios",
    "dist",
    "**/dist",
    "**/build",
    "**/coverage",
    "**/.expo"
  ]
}
